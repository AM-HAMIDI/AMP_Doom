################################################################
#
# Makefile.pos - doomgeneric for the POS terminal
#
#   Target : ARMv7 Cortex-A7, soft-float ABI (armel), glibc 2.22
#   Output : one static binary, no shared libraries needed on the device
#
# Usage:
#   make -f Makefile.pos                                    # Ubuntu cross-compiler
#   make -f Makefile.pos CROSS_COMPILE=arm-oe-linux-gnueabi-   # vendor SDK
#   make -f Makefile.pos clean
#
# Ubuntu toolchain: sudo apt install gcc-arm-linux-gnueabi
#
################################################################

ifeq ($(V),1)
	VB =
else
	VB = @
endif

CROSS_COMPILE ?= arm-linux-gnueabi-
CC    = $(CROSS_COMPILE)gcc
STRIP = $(CROSS_COMPILE)strip

# Cortex-A7 with NEON/VFPv4, soft-float calling convention (armel)
ARCH_FLAGS ?= -march=armv7-a -mtune=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=softfp

# Native 320x200 render; sound off (FEATURE_SOUND is not defined)
CFLAGS += $(ARCH_FLAGS) -O2 -Wall
CFLAGS += -DNORMALUNIX -DLINUX -D_DEFAULT_SOURCE
CFLAGS += -DDOOMGENERIC_RESX=320 -DDOOMGENERIC_RESY=200

# Static link: the device's glibc 2.22 is older than any current toolchain's
LDFLAGS += -static -Wl,--gc-sections
LIBS    += -lm

OBJDIR = build_pos
OUTDIR = ../output
OUTPUT = $(OUTDIR)/doomgeneric_pos

SRC_DOOM = dummy.o am_map.o doomdef.o doomstat.o dstrings.o d_event.o d_items.o d_iwad.o d_loop.o d_main.o d_mode.o d_net.o f_finale.o f_wipe.o g_game.o hu_lib.o hu_stuff.o info.o i_cdmus.o i_endoom.o i_joystick.o i_scale.o i_sound.o i_system.o i_timer.o memio.o m_argv.o m_bbox.o m_cheat.o m_config.o m_controls.o m_fixed.o m_menu.o m_misc.o m_random.o p_ceilng.o p_doors.o p_enemy.o p_floor.o p_inter.o p_lights.o p_map.o p_maputl.o p_mobj.o p_plats.o p_pspr.o p_saveg.o p_setup.o p_sight.o p_spec.o p_switch.o p_telept.o p_tick.o p_user.o r_bsp.o r_data.o r_draw.o r_main.o r_plane.o r_segs.o r_sky.o r_things.o sha1.o sounds.o statdump.o st_lib.o st_stuff.o s_sound.o tables.o v_video.o wi_stuff.o w_checksum.o w_file.o w_main.o w_wad.o z_zone.o w_file_stdc.o i_input.o i_video.o doomgeneric.o doomgeneric_pos.o mus2mid.o
OBJS += $(addprefix $(OBJDIR)/, $(SRC_DOOM))

all: $(OUTPUT)

clean:
	rm -rf $(OBJDIR)
	rm -f $(OUTPUT)

$(OUTPUT): $(OBJS) | $(OUTDIR)
	@echo [Linking $@]
	$(VB)$(CC) $(CFLAGS) $(LDFLAGS) $(OBJS) -o $(OUTPUT) $(LIBS)
	$(VB)$(STRIP) $(OUTPUT)
	@echo [Size]
	-$(VB)ls -l $(OUTPUT)

$(OBJS): | $(OBJDIR)

$(OBJDIR):
	mkdir -p $(OBJDIR)

$(OUTDIR):
	mkdir -p $(OUTDIR)

$(OBJDIR)/%.o: %.c
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) -c $< -o $@

.PHONY: all clean